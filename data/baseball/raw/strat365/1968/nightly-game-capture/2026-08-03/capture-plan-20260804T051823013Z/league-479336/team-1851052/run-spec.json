{
    "schemaVersion":  "strat365-league-capture-run-v0",
    "baseUri":  "https://365.strat-o-matic.com",
    "playerSetYear":  "1968",
    "leagueId":  "479336",
    "leagueDate":  "2026-08-03",
    "expectedCounts":  {
                           "teamCount":  2,
                           "gameCount":  3,
                           "seriesCount":  1
                       },
    "teamIds":  [
                    "1851052",
                    "1853540"
                ],
